# Copy to .env.local and adjust.

# Origin of the Coverly backend. Use the PORT from the backend's own .env.
VITE_API_BASE_URL=http://localhost:4000

# Endpoint groups MSW mocks in dev: recordings, songs, auth, artists, tags, or all.
# Unmocked requests go to VITE_API_BASE_URL. Leave empty to disable MSW.
# If this variable is absent entirely, it defaults to "recordings".
VITE_MOCK_GROUPS=recordings
